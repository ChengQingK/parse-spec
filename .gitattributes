* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Batch files: cmd.exe needs CRLF and cannot tolerate UTF-8 non-ASCII (GBK codepage)
*.bat text eol=crlf
*.cmd text eol=crlf

*.pdf binary
*.whl binary
